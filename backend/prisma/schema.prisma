generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------------------------------------------------------
// ENUMS (Removed for SQLite compatibility)
// ---------------------------------------------------------

// ---------------------------------------------------------
// 1. USER
// ---------------------------------------------------------
model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  trips             Trip[]
  savedDestinations SavedDestination[]
  travelEvents      TravelBehaviorEvent[]
  travelPreferences TravelPreferenceProfile[]
  travelInsights    TravelInsight[]
}

// ---------------------------------------------------------
// 2. COUNTRY
// ---------------------------------------------------------
model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destinations Destination[]
}

// ---------------------------------------------------------
// 3. DESTINATION
// ---------------------------------------------------------
model Destination {
  id          String   @id @default(uuid())
  countryId   String
  name        String
  slug        String
  latitude    Float
  longitude   Float
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  places      Place[]
  trips       Trip[]
  savedBy     SavedDestination[]

  @@unique([countryId, slug])
  @@index([slug])
  @@index([countryId])
}

// ---------------------------------------------------------
// 4. PLACE
// ---------------------------------------------------------
model Place {
  id            String   @id @default(uuid())
  destinationId String
  name          String
  description   String?
  category      String
  tags          String?
  estimatedCost Float
  currency      String   @default("USD")
  duration      Int?     // duration in minutes (averageVisitDuration)
  latitude      Float?
  longitude     Float?
  imageUrl      String?
  rating        Float?
  popularity    Int?
  openingTime   String?
  closingTime   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  activities    Activity[]

  @@index([destinationId])
}

// ---------------------------------------------------------
// 5. TRIP
// ---------------------------------------------------------
model Trip {
  id            String     @id @default(uuid())
  userId        String
  destinationId String?
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  travelers     Int        @default(1)
  budget        Float?
  currency      String?
  coverImage    String?
  status        String     @default("PLANNED")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  
  itineraryDays     ItineraryDay[]
  expenses          Expense[]
  accommodations    Accommodation[]
  transportations   Transportation[]
  preparationItems  PreparationItem[]
  preferences       TripPreference[]
  sharedTrip        SharedTrip?

  @@index([userId])
  @@index([destinationId])
}

// ---------------------------------------------------------
// 6. ITINERARY DAY
// ---------------------------------------------------------
model ItineraryDay {
  id            String   @id @default(uuid())
  tripId        String
  dayNumber     Int
  title         String?
  date          DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities    Activity[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

// ---------------------------------------------------------
// 7. ACTIVITY
// ---------------------------------------------------------
model Activity {
  id            String    @id @default(uuid())
  itineraryDayId String
  placeId       String?
  title         String?
  description   String?
  location      String?
  category      String?
  estimatedCost Float?
  currency      String?
  imageUrl      String?
  date          DateTime?
  startTime     DateTime?
  endTime       DateTime?
  order         Int
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  itineraryDay  ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place         Place?       @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@index([itineraryDayId])
  @@index([placeId])
}

// ---------------------------------------------------------
// 8. EXPENSE
// ---------------------------------------------------------
model Expense {
  id          String          @id @default(uuid())
  tripId      String
  category    String
  amount      Float
  currency    String
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([date])
}

// ---------------------------------------------------------
// 9. SAVED DESTINATION
// ---------------------------------------------------------
model SavedDestination {
  id            String   @id @default(uuid())
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@index([destinationId])
}

// ---------------------------------------------------------
// 10. SHARED TRIP
// ---------------------------------------------------------
model SharedTrip {
  id        String    @id @default(uuid())
  tripId    String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// 11. ACCOMMODATION
// ---------------------------------------------------------
model Accommodation {
  id               String   @id @default(uuid())
  tripId           String
  name             String
  address          String?
  checkInDate      DateTime
  checkOutDate     DateTime
  checkInTime      String?  // e.g. "14:00"
  checkOutTime     String?  // e.g. "11:00"
  nights           Int
  pricePerNight    Float?
  totalCost        Float
  currency         String   @default("USD")
  guests           Int      @default(1)
  bookingReference String?
  notes            String?
  latitude         Float?
  longitude        Float?
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ---------------------------------------------------------
// 12. TRANSPORTATION
// ---------------------------------------------------------
model Transportation {
  id                String   @id @default(uuid())
  tripId            String
  type              String   // e.g., Flight, Train, Bus, Car, Taxi, Metro, Other
  provider          String?
  departureLocation String
  arrivalLocation   String
  departureDate     DateTime
  departureTime     String?  // e.g. "08:30"
  arrivalDate       DateTime
  arrivalTime       String?  // e.g. "10:45"
  cost              Float
  currency          String   @default("USD")
  bookingReference  String?
  notes             String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ---------------------------------------------------------
// 13. PREPARATION ITEM
// ---------------------------------------------------------
model PreparationItem {
  id          String   @id @default(uuid())
  tripId      String
  category    String   // Documents, Clothing, Electronics, etc.
  name        String
  isCompleted Boolean  @default(false)
  isSuggested Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ---------------------------------------------------------
// 14. TRIP PREFERENCE
// ---------------------------------------------------------
model TripPreference {
  id          String   @id @default(uuid())
  tripId      String
  preference  String   // e.g. ADVENTURE, CULTURE, FOOD, RELAXATION
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ---------------------------------------------------------
// 15. TRAVEL BEHAVIOR EVENT (Phase 9)
// ---------------------------------------------------------
model TravelBehaviorEvent {
  id          String   @id @default(uuid())
  userId      String
  tripId      String?
  eventType   String   // e.g. PLACE_VIEWED, ACTIVITY_ADDED, PREFERENCE_UPDATED
  entityType  String?
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
}

// ---------------------------------------------------------
// 16. TRAVEL PREFERENCE PROFILE (Phase 9)
// ---------------------------------------------------------
model TravelPreferenceProfile {
  id            String   @id @default(uuid())
  userId        String
  category      String   // e.g. Culture, Adventure, Budget Style, Pace
  score         Float    // 0 to 100
  confidence    Float    // 0.0 to 1.0
  evidenceCount Int      @default(0)
  source        String   // EXPLICIT, INFERRED, MIXED
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

// ---------------------------------------------------------
// 17. TRAVEL INSIGHT (Phase 9)
// ---------------------------------------------------------
model TravelInsight {
  id          String   @id @default(uuid())
  userId      String
  type        String   // e.g. PACE, BUDGET, STYLE
  title       String
  description String
  confidence  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
