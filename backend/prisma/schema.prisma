generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------
enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITY
  OTHER
}

// ---------------------------------------------------------
// 1. USER
// ---------------------------------------------------------
model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  trips             Trip[]
  savedDestinations SavedDestination[]
}

// ---------------------------------------------------------
// 2. COUNTRY
// ---------------------------------------------------------
model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities    City[]
}

// ---------------------------------------------------------
// 3. CITY
// ---------------------------------------------------------
model City {
  id          String   @id @default(uuid())
  countryId   String
  name        String
  slug        String
  latitude    Float
  longitude   Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  activities  Activity[]
  tripStops   TripStop[]
  savedBy     SavedDestination[]

  @@unique([countryId, slug])
  @@index([slug])
  @@index([countryId])
}

// ---------------------------------------------------------
// 4. ACTIVITY
// ---------------------------------------------------------
model Activity {
  id            String   @id @default(uuid())
  cityId        String
  name          String
  description   String?
  category      String
  tags          String?  // Phase 5 (stored as comma separated for SQLite)
  estimatedCost Float
  duration      Int?     // duration in minutes
  latitude      Float?   // Phase 5
  longitude     Float?   // Phase 5
  imageUrl      String?  // Phase 5
  rating        Float?   // Phase 5
  popularity    Int?     // Phase 5 (1-100)
  openingTime   String?  // Phase 5 (e.g. "09:00")
  closingTime   String?  // Phase 5 (e.g. "18:00")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city          City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  itineraryItems ItineraryActivity[]

  @@index([cityId])
}

// ---------------------------------------------------------
// 5. TRIP
// ---------------------------------------------------------
model Trip {
  id          String     @id @default(uuid())
  userId      String
  title       String
  destination String     @default("TBD")
  description String?
  startDate   DateTime
  endDate     DateTime
  travelers   Int        @default(1)
  budget      Float?
  currency    String?
  coverImage  String?
  interests   String?    // Phase 5 (stored as comma separated for SQLite)
  status      TripStatus @default(PLANNED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripStops         TripStop[]
  expenses          Expense[]
  accommodations    Accommodation[]
  transportations   Transportation[]
  preparationItems  PreparationItem[]
  sharedTrip        SharedTrip?

  @@index([userId])
}

// ---------------------------------------------------------
// 6. TRIP STOP
// ---------------------------------------------------------
model TripStop {
  id            String   @id @default(uuid())
  tripId        String
  cityId        String?
  order         Int
  title         String?
  date          DateTime?
  arrivalDate   DateTime?
  departureDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city          City?    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  activities    ItineraryActivity[]

  @@unique([tripId, order])
  @@index([tripId])
  @@index([cityId])
}

// ---------------------------------------------------------
// 7. ITINERARY ACTIVITY
// ---------------------------------------------------------
model ItineraryActivity {
  id            String    @id @default(uuid())
  tripStopId    String
  activityId    String?
  title         String?
  description   String?
  location      String?
  category      String?
  estimatedCost Float?
  currency      String?
  imageUrl      String?
  date          DateTime?
  startTime     DateTime?
  endTime       DateTime?
  order         Int
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tripStop      TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity      Activity? @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([tripStopId])
  @@index([activityId])
}

// ---------------------------------------------------------
// 8. EXPENSE
// ---------------------------------------------------------
model Expense {
  id          String          @id @default(uuid())
  tripId      String
  category    ExpenseCategory
  amount      Float
  currency    String
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([date])
}

// ---------------------------------------------------------
// 9. SAVED DESTINATION
// ---------------------------------------------------------
model SavedDestination {
  id        String   @id @default(uuid())
  userId    String
  cityId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@index([userId])
  @@index([cityId])
}

// ---------------------------------------------------------
// 10. SHARED TRIP
// ---------------------------------------------------------
model SharedTrip {
  id        String    @id @default(uuid())
  tripId    String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// 11. ACCOMMODATION
// ---------------------------------------------------------
model Accommodation {
  id               String   @id @default(uuid())
  tripId           String
  name             String
  address          String?
  checkInDate      DateTime 
  checkOutDate     DateTime 
  checkInTime      String?  // e.g. "14:00"
  checkOutTime     String?  // e.g. "11:00"
  nights           Int
  pricePerNight    Float?
  totalCost        Float
  currency         String   @default("USD")
  guests           Int      @default(1)
  bookingReference String?
  notes            String?
  latitude         Float?
  longitude        Float?
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ---------------------------------------------------------
// 12. TRANSPORTATION
// ---------------------------------------------------------
model Transportation {
  id                String   @id @default(uuid())
  tripId            String
  type              String   // e.g., Flight, Train, Bus, Car, Taxi, Metro, Other
  provider          String?
  departureLocation String
  arrivalLocation   String
  departureDate     DateTime 
  departureTime     String?  // e.g. "08:30"
  arrivalDate       DateTime 
  arrivalTime       String?  // e.g. "10:45"
  cost              Float
  currency          String   @default("USD")
  bookingReference  String?
  notes             String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ---------------------------------------------------------
// 13. PREPARATION ITEM
// ---------------------------------------------------------
model PreparationItem {
  id          String   @id @default(uuid())
  tripId      String
  category    String   // Documents, Clothing, Electronics, etc.
  name        String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}
